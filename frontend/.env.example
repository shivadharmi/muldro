# ─────────────────────────────────────────────────────────────────────────────
# Muldro frontend configuration — copy to frontend/.env.local
#
# Next.js loads .env.local automatically. `NEXT_PUBLIC_*` values are inlined
# into the CLIENT bundle at build time and are visible to anyone who opens the
# page — never put a secret behind that prefix.
#
# For the standard local setup (`docker compose up -d` + `python run.py
# --worker` + `npm run dev`) you need NONE of these: every default below is
# already correct. They exist for non-default topologies.
# ─────────────────────────────────────────────────────────────────────────────


# Server-side only (never reaches the browser). The origin that Next.js proxies
# /api/:path* to, rewritten to <backend>/v1/:path* — see frontend/next.config.ts
# — and used by the SSE chat Route Handler at
# frontend/src/app/api/muldro/chat/route.ts.
# Default when unset: http://localhost:8000
# The repo-root docker-compose.yml sets this to http://api:8000 for the `web`
# service, so do not hardcode a value that breaks the compose path.
# BACKEND_URL=http://localhost:8000


# Client-side. WebSocket base, used by frontend/src/hooks/use-muldro-ws.ts to
# build `${NEXT_PUBLIC_WS_URL}/ws/{userId}`. Give it a scheme and host with no
# trailing slash and no /ws suffix.
# When unset, the hook derives the socket URL from NEXT_PUBLIC_BACKEND_URL, and
# failing that from the page's own origin (window.location) — which is correct
# whenever the backend is reachable at the same host as the frontend.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000


# Client-side. Fallback origin for the WebSocket derivation above ONLY. REST
# calls do NOT use it: frontend/src/lib/api.ts always fetches the relative path
# `/api/...` and relies on the Next rewrite. Setting this does not redirect REST
# traffic.
# Default when unset: the page's own origin.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# Client-side. Bearer-token FALLBACK used when no session token is present in
# localStorage — read in frontend/src/lib/api.ts, src/hooks/use-sse.ts and
# src/components/knowledge/memory-detail-panel.tsx as
# `getStoredToken() || process.env.NEXT_PUBLIC_API_TOKEN || ""`.
#
# ⚠ This is inlined into the client bundle and served to every visitor. It is a
#   development convenience for skipping the magic-link sign-in, not an auth
#   mechanism. Leave it unset in any deployment that is not your own laptop.
#
# In normal local development you do not need it: leave MULDRO_BACKEND_TOKEN
# empty in backend/.env and POST /v1/auth/magic-link returns the sign-in token
# in its response body, which the /login page fills in for you.
# NEXT_PUBLIC_API_TOKEN=

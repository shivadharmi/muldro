# ── Minimal Muldro configuration ─────────────────────────────────────────────
# Copy this file to backend/.env, set your Anthropic API key, then run:
#
#     docker compose --profile app up
#
# Infrastructure URLs (Postgres, Redis, Qdrant, Neo4j) are supplied by
# docker-compose. Two values are yours to set: an Anthropic API key, and the
# gateway escape hatch below -- startup registers OAuth client configs with the
# OpenConnector gateway and ABORTS if it is unconfigured.

# REQUIRED — get a key at https://console.anthropic.com
MULDRO_ANTHROPIC_API_KEY=your-key-here

# REQUIRED unless you have stood up the OpenConnector gateway. Without this,
# startup raises in register_gateway_oauth_configs() and the app never serves.
# See docs/setup.md for what running the gateway involves.
MULDRO_SKIP_GATEWAY_VALIDATION=true

# Optional — encrypt OAuth tokens at rest. Recommended; REQUIRED in production.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MULDRO_OAUTH_ENCRYPTION_KEY=

# Optional — connect Google/GitHub/Slack later by filling in their OAuth creds.
# See backend/.env.example for the full list of supported settings.

# ── Minimal Muldro configuration ─────────────────────────────────────────────
# Copy this file to backend/.env, set your Anthropic API key, then run:
#
#     docker compose --profile app up
#
# Infrastructure URLs (Postgres, Redis, Qdrant, Neo4j) are supplied by
# docker-compose, so the only value you must provide is your Anthropic API key.

# REQUIRED — get a key at https://console.anthropic.com
MULDRO_ANTHROPIC_API_KEY=your-key-here

# Optional — use AWS Bedrock instead of the Anthropic API (uses AWS creds).
# MULDRO_USE_BEDROCK=true

# Optional — encrypt OAuth tokens at rest. Recommended; REQUIRED in production.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MULDRO_OAUTH_ENCRYPTION_KEY=

# Optional — connect Google/GitHub/Slack later by filling in their OAuth creds.
# See backend/.env.example for the full list of supported settings.

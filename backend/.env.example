# Jarvis Backend Configuration

# Database
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
JARVIS_REDIS_URL=redis://localhost:6379/0

# AI Model — choose one:
# Option A: Direct Anthropic API
JARVIS_ANTHROPIC_API_KEY=your-anthropic-api-key-here
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-6
JARVIS_USE_BEDROCK=false
# Option B: AWS Bedrock (set USE_BEDROCK=true, no API key needed — uses IAM role)
# JARVIS_USE_BEDROCK=true
# JARVIS_BEDROCK_REGION=us-east-1
# JARVIS_ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# Embeddings (Bedrock Titan)
JARVIS_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=true

# Security
JARVIS_BACKEND_TOKEN=your-backend-token-here

# OAuth encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
JARVIS_OAUTH_ENCRYPTION_KEY=your-fernet-key-here

# Google OAuth (from client_secret.json)
JARVIS_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JARVIS_GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
JARVIS_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Auth
JARVIS_SESSION_SECRET_KEY=change-me-to-a-random-string
JARVIS_MAGIC_LINK_TTL_MINUTES=15
JARVIS_SESSION_TTL_HOURS=720

# Frontend (for OAuth redirects)
JARVIS_FRONTEND_URL=http://localhost:3000

# CORS
JARVIS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# GitHub OAuth (optional)
# JARVIS_GITHUB_OAUTH_CLIENT_ID=
# JARVIS_GITHUB_OAUTH_CLIENT_SECRET=
# JARVIS_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# Atlassian OAuth (Jira + Confluence via Rovo MCP; optional)
# JARVIS_ATLASSIAN_OAUTH_CLIENT_ID=
# JARVIS_ATLASSIAN_OAUTH_CLIENT_SECRET=
# JARVIS_ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/atlassian/callback

# Budget
JARVIS_DAILY_TOKEN_BUDGET_USD=5.0

# Logging
# JARVIS_LOG_JSON=true

# Filesystem MCP server root (defaults to ~/jarvis-workspace, created on startup)
# JARVIS_FILESYSTEM_MCP_ROOT=/path/to/workspace

# --- Optional Infrastructure (system works without these) ---

# Elasticsearch (trace persistence — falls back to in-memory)
# JARVIS_ELASTICSEARCH_URL=http://localhost:9200

# Qdrant (vector search — falls back to pgvector)
# JARVIS_QDRANT_URL=http://localhost:6333

# Neo4j (graph traversal — disabled if not set)
# JARVIS_NEO4J_URL=bolt://localhost:7687
# JARVIS_NEO4J_USER=neo4j
# JARVIS_NEO4J_PASSWORD=jarvisdev

# S3/MinIO (artifact storage)
# JARVIS_S3_BUCKET=jarvis-artifacts
# JARVIS_S3_ENDPOINT_URL=http://localhost:9000
# JARVIS_S3_REGION=ap-south-1

# ─────────────────────────────────────────────────────────────────────────────
# Muldro backend configuration — copy to backend/.env
#
# Every setting is read by pydantic-settings from backend/src/config/settings.py
# with the env prefix MULDRO_. The values shown are the REAL defaults from that
# file; a line that is commented out is already at its default.
#
# ⚠ FOOTGUN: Settings declares `"extra": "ignore"`. A misspelled or obsolete
#   MULDRO_* variable is SILENTLY SWALLOWED — no error, no warning, no log line.
#   `MULDRO_ANTHROPC_API_KEY=...` looks set and is not. If a setting appears to
#   have no effect, check the spelling against settings.py before anything else.
#
# ⚠ Never commit this file once filled in. Root .gitignore ignores `.env`.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# CORE — required to boot
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED. Enforced in settings.py::validate_startup(), called from the
# FastAPI lifespan (src/api/app.py) — an empty value raises RuntimeError and
# ABORTS STARTUP. Get a key at https://console.anthropic.com
MULDRO_ANTHROPIC_API_KEY=sk-ant-replace-me

# REQUIRED unless you have actually stood up the OpenConnector gateway.
# Default is `false`. Left false, src/api/app.py calls
# register_gateway_oauth_configs() unguarded and that raises RuntimeError —
# ABORTS STARTUP — when the OpenConnector admin URL/token are unset, and again
# when any gateway provider's OAuth client id/secret is empty (google, github,
# notion, atlassian are all required). Gateway setup: infra/gateway/README.md
MULDRO_SKIP_GATEWAY_VALIDATION=true

# OPTIONAL. Environment discriminator: development | staging | production.
# `production` makes MULDRO_OAUTH_ENCRYPTION_KEY mandatory (validate_startup).
MULDRO_ENVIRONMENT=development

# OPTIONAL. Default direct-Anthropic model id (settings.resolved_model).
# Per-tier model choice is DB data (ModelBinding), not this value.
# MULDRO_ANTHROPIC_MODEL=claude-sonnet-4-6

# OPTIONAL. Server bind + debug. Debug enables uvicorn --reload.
# MULDRO_HOST=0.0.0.0
# MULDRO_PORT=8000
# MULDRO_DEBUG=false

# OPTIONAL. Structured JSON logging instead of human-readable lines.
# MULDRO_LOG_JSON=false


# ═══════════════════════════════════════════════════════════════════════════
# DATABASE / REDIS
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED in practice — the default points at the docker-compose Postgres.
# `docker compose --profile app up` overrides this with the compose hostname.
MULDRO_DATABASE_URL=postgresql+asyncpg://muldro:muldro@localhost:5432/muldro

# REQUIRED in practice — Redis backs streams, cache, locks and pubsub.
MULDRO_REDIS_URL=redis://localhost:6379/0

# OPTIONAL. asyncpg per-connection self-protection (milliseconds). The idle
# ceiling must exceed the longest legitimate idle-in-transaction window —
# GraphExecutor holds one session across a whole DAG. Do not lower blindly.
# MULDRO_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=900000
# MULDRO_DB_STATEMENT_TIMEOUT_MS=120000


# ═══════════════════════════════════════════════════════════════════════════
# MODEL PROVIDERS
# ═══════════════════════════════════════════════════════════════════════════
# These are an ENV FALLBACK only. Keys entered through the UI live encrypted in
# the `provider_credentials` table. Ollama is keyless (authenticates by
# base_url alone). See src/config/model_catalog.py for the provider catalog.

# OPTIONAL. Needed only if a model tier is bound to an OpenAI model.
# MULDRO_OPENAI_API_KEY=

# OPTIONAL. Needed only if a model tier is bound to a Google/Gemini model.
# MULDRO_GOOGLE_API_KEY=

# CONDITIONALLY REQUIRED — Fernet key encrypting UI-entered provider
# credentials at rest (src/config/secret_crypto.py). The failure is DELAYED:
# startup succeeds while the table is empty, but once ANY encrypted provider
# credential exists in the DB, src/api/app.py raises RuntimeError at boot if
# this is unset. Set it BEFORE saving a provider key in the UI.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MULDRO_CONFIG_ENCRYPTION_KEY=

# OPTIONAL. Daily spend ceiling before the budget tracker degrades behaviour.
# MULDRO_DAILY_TOKEN_BUDGET_USD=25.0

# OPTIONAL. All-Sonnet preset (no Opus) + halved thinking budgets.
# MULDRO_CHEAP_MODE=false


# ═══════════════════════════════════════════════════════════════════════════
# SECURITY / AUTH
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL, but load-bearing for local dev: when EMPTY, POST /v1/auth/magic-link
# returns the sign-in token directly in the response body ("dev mode") so you
# can log in without an email provider. Set it and magic links are emailed via
# SES instead (see the SES block below).
# MULDRO_BACKEND_TOKEN=

# CONDITIONALLY REQUIRED — Fernet key encrypting OAuth tokens at rest.
# validate_startup() raises RuntimeError when MULDRO_ENVIRONMENT=production and
# this is unset. Optional (but recommended) in development.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MULDRO_OAUTH_ENCRYPTION_KEY=

# OPTIONAL. Comma-separated allowed origins. DEFAULT IS EMPTY, which installs
# NO CORS middleware at all (src/api/app.py). That is correct for the standard
# local setup, where the browser only ever talks to Next.js and Next proxies
# /api/* to the backend. Set this only if a browser calls :8000 directly.
# MULDRO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# OPTIONAL. Per-IP request ceiling and max request body size (bytes).
# MULDRO_RATE_LIMIT_RPM=120
# MULDRO_MAX_REQUEST_BODY_BYTES=1048576

# OPTIONAL. Magic-link and session lifetimes.
# MULDRO_MAGIC_LINK_TTL_MINUTES=15
# MULDRO_SESSION_TTL_HOURS=720

# OPTIONAL. Base URL the backend builds magic-link redirects against.
# MULDRO_FRONTEND_URL=http://localhost:3000

# OPTIONAL. AWS SES delivery for magic-link emails. Must be explicitly enabled;
# only consulted when MULDRO_BACKEND_TOKEN is set (otherwise dev mode returns
# the token inline).
# MULDRO_SES_ENABLED=false
# MULDRO_SES_FROM_ADDRESS=
# MULDRO_SES_REGION=ap-south-1


# ═══════════════════════════════════════════════════════════════════════════
# OPENCONNECTOR GATEWAY  (leave the whole block unset if you set
# MULDRO_SKIP_GATEWAY_VALIDATION=true)
# ═══════════════════════════════════════════════════════════════════════════
# Standing up this gateway is a multi-hour MANUAL process — see
# infra/gateway/README.md §5. Until it is done, the Google Workspace, GitHub,
# Notion and Atlassian installations are INERT: seed_installations.py gives all
# four auth_provider="platform_jwt" with remote_url=None, and mcp_pool.py raises
# GatewayNotConfigured for any of them when MULDRO_TOOLHIVE_VMCP_URL is unset.

# REQUIRED WHEN THE GATEWAY IS ON. The single switch that routes gateway-backed
# installations. There is no per-provider flag. (src/integrations/mcp_pool.py)
# MULDRO_TOOLHIVE_VMCP_URL=http://localhost:8080/mcp

# REQUIRED WHEN THE GATEWAY IS ON, for the API process. Startup registration of
# one OAuth client config per provider PUTs to this admin plane. Missing =>
# RuntimeError at boot. (src/integrations/gateway_oauth_registrar.py)
# MULDRO_OPENCONNECTOR_ADMIN_URL=http://127.0.0.1:3001
# MULDRO_OPENCONNECTOR_ADMIN_TOKEN=

# REQUIRED WHEN THE GATEWAY IS ON, for the CONNECTION-ADAPTER process only
# (backend/run_adapter.py → src/adapter/openconnector_client.py). The repo-root
# API process does not read these; infra/gateway/docker-compose.yml sets them.
# MULDRO_OPENCONNECTOR_MCP_URL=http://openconnector:3001/mcp
# MULDRO_OPENCONNECTOR_RUNTIME_TOKEN=

# RSA keypair for minting/verifying tenant-scoped platform JWTs. Split by role:
# only the MINTER (the Muldro API process) gets the PRIVATE half; a verify-only
# process — notably the connection adapter, which IS the tenant-isolation
# boundary — gets the PUBLIC half alone. If neither is set, platform_jwt.py
# falls back to an ephemeral per-process key and tokens minted by the API are
# unverifiable by the adapter.
#   openssl genrsa -out platform-jwt.pem 2048
#   openssl rsa -in platform-jwt.pem -pubout -out platform-jwt.pub
# Multi-line PEMs in a .env file are fragile — prefer exporting these from a
# secret manager or a wrapper script rather than pasting them here.
# MULDRO_PLATFORM_JWT_PRIVATE_PEM=
# MULDRO_PLATFORM_JWT_PUBLIC_PEM=


# ═══════════════════════════════════════════════════════════════════════════
# OAUTH CLIENT CREDENTIALS
# ═══════════════════════════════════════════════════════════════════════════
# When the gateway is ON, gateway_oauth_registrar.py requires client id AND
# secret for EVERY provider in the registry — google, github, notion, atlassian
# — and raises RuntimeError (aborting startup) if any pair is incomplete.
# When MULDRO_SKIP_GATEWAY_VALIDATION=true they are all optional.
#
# Note the asymmetry: Notion has NO redirect_uri setting. Its OAuth callback
# lands on the gateway, not on Muldro.

# MULDRO_GOOGLE_OAUTH_CLIENT_ID=your-id.apps.googleusercontent.com
# MULDRO_GOOGLE_OAUTH_CLIENT_SECRET=
# MULDRO_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# MULDRO_GITHUB_OAUTH_CLIENT_ID=
# MULDRO_GITHUB_OAUTH_CLIENT_SECRET=
# MULDRO_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# MULDRO_NOTION_OAUTH_CLIENT_ID=
# MULDRO_NOTION_OAUTH_CLIENT_SECRET=

# MULDRO_ATLASSIAN_OAUTH_CLIENT_ID=
# MULDRO_ATLASSIAN_OAUTH_CLIENT_SECRET=
# MULDRO_ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/atlassian/callback


# ═══════════════════════════════════════════════════════════════════════════
# STDIO MCP SERVERS — bare (NON-prefixed) environment variables
# ═══════════════════════════════════════════════════════════════════════════
# These are NOT MULDRO_-prefixed and are NOT part of Settings. They are read
# straight from the process environment by
# src/integrations/control_plane.py::resolve_env_credentials(), which resolves
# the names declared in an installation's `env_template`. Only the Slack
# installation declares any (src/integrations/seed_installations.py). The
# declared names are ALTERNATIVES, not a conjunction — either token suffices.
#
# Slack runs as an on-demand `npx slack-mcp-server` stdio process and therefore
# works WITHOUT the OpenConnector gateway.
#
# SLACK_MCP_XOXP_TOKEN=xoxp-...
# SLACK_MCP_XOXB_TOKEN=xoxb-...


# ═══════════════════════════════════════════════════════════════════════════
# EMBEDDINGS AND RERANKING — local fastembed (ONNX, no external API)
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL. Determines the vector dimension; keep in sync with
# vector_store.VECTOR_SIZE (bge-base-en-v1.5 = 768). Do NOT set this to a
# hosted model id — nothing calls a remote embedding API.
# MULDRO_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# OPTIONAL. Local cross-encoder reranker.
# MULDRO_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
# MULDRO_RERANKER_ENABLED=true


# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL INFRASTRUCTURE (the system boots without these)
# ═══════════════════════════════════════════════════════════════════════════
# The repo-root docker-compose.yml starts all of these; the `app` profile sets
# the Qdrant and Neo4j values automatically. Set them here for native dev.

# Qdrant — vector search.
# MULDRO_QDRANT_URL=http://localhost:6333
# MULDRO_QDRANT_API_KEY=

# Neo4j — knowledge graph. Disabled entirely when the URL is unset.
# MULDRO_NEO4J_URL=bolt://localhost:7687
# MULDRO_NEO4J_USER=neo4j
# MULDRO_NEO4J_PASSWORD=muldrodev

# S3 / MinIO — artifact storage. Local dev uses the compose MinIO service
# (muldro / muldrodev). Leave the key/secret EMPTY in production so the default
# AWS credential chain (IAM role / instance profile) is used.
# MULDRO_S3_BUCKET=muldro-artifacts
# MULDRO_S3_ENDPOINT_URL=http://localhost:9000
# MULDRO_S3_REGION=ap-south-1
# MULDRO_S3_ACCESS_KEY_ID=muldro
# MULDRO_S3_SECRET_ACCESS_KEY=muldrodev


# ═══════════════════════════════════════════════════════════════════════════
# PERCEPTION, SCHEDULING AND BACKPRESSURE
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL. Events scoring above this trigger planning.
# MULDRO_IMPORTANCE_THRESHOLD=0.7

# OPTIONAL. Default briefing time window.
# MULDRO_BRIEFING_LOOKBACK_HOURS=24

# OPTIONAL. Per-source staleness before a poll is due (minutes).
# MULDRO_OBSERVATION_STALE_GMAIL_MINUTES=30
# MULDRO_OBSERVATION_STALE_CALENDAR_MINUTES=180
# MULDRO_OBSERVATION_STALE_GITHUB_MINUTES=60
# MULDRO_OBSERVATION_STALE_NOTION_MINUTES=60

# OPTIONAL. Scheduler resilience. A perception tick is a poll plus a triage
# call plus a relevance call plus body fetches — each a provider round trip —
# so this ceiling is generous on purpose. Lowering it silently truncates
# perception AFTER cards are published but BEFORE the Planner gate.
# MULDRO_SCHEDULER_SUBTICK_TIMEOUT_S=300.0
# MULDRO_RESUME_REAPER_STALE_AFTER_S=300.0
# MULDRO_RESUME_REAPER_MAX_ATTEMPTS=5
# MULDRO_RESUME_REAPER_BATCH_LIMIT=5

# OPTIONAL. Concurrency / backpressure ceilings.
# MULDRO_EVENT_PROCESSOR_CONCURRENCY=5
# MULDRO_MAX_PERCEPTION_PER_TICK=5
# MULDRO_WEBHOOK_LAG_THRESHOLD=5000

# OPTIONAL. On-demand local MCP process lifecycle + idle-session reaper.
# MULDRO_MCP_LOCAL_READY_TIMEOUT_S=30.0
# MULDRO_MCP_SESSION_IDLE_TTL_S=120.0

# OPTIONAL. Push/webhook infrastructure. Empty = poll-only, which is the
# default and needs no external infra. `webhooks_configured` requires BOTH the
# master switch and a public HTTPS callback base before any channel is created.
# MULDRO_WEBHOOKS_ENABLED=false
# MULDRO_WEBHOOK_CALLBACK_BASE_URL=https://muldro.example.com
# MULDRO_GMAIL_PUBSUB_TOPIC=projects/<proj>/topics/<topic>


# ═══════════════════════════════════════════════════════════════════════════
# HARDENING / RETRY / TTLs
# ═══════════════════════════════════════════════════════════════════════════

# MULDRO_PLAN_TTL_HOURS=72
# MULDRO_APPROVAL_TTL_HOURS=24
# MULDRO_DLQ_MAX_ATTEMPTS=3
# MULDRO_RETRY_MAX_ATTEMPTS=3
# MULDRO_RETRY_BASE_DELAY=1.0
# MULDRO_RETRY_MAX_DELAY=30.0


# ═══════════════════════════════════════════════════════════════════════════
# ESCAPE HATCHES AND FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════
# Everything here defaults to false. The deep_* / chat_planless flags are
# in-progress work, not supported configuration — leave them alone unless you
# are developing that subsystem.

# Emergency bypass of the startup tool-registry cross-checks. A malformed
# registry normally refuses to serve traffic.
# MULDRO_SKIP_REGISTRY_VALIDATION=false

# Refuse a WRITE tool call when Redis is unreachable, instead of executing it
# unlocked. Recommended for production; default preserves fail-open.
# MULDRO_WRITE_LOCK_REQUIRE_REDIS=false

# In-progress runtime flags — dormant by default.
# MULDRO_DEEP_INLINE_FORMAT=false
# MULDRO_DEEP_DELEGATES_ENABLED=false
# MULDRO_DEEP_READBACK_ENABLED=false
# MULDRO_DEEP_CONTEXT_JIT=false
# MULDRO_CHAT_PLANLESS=false

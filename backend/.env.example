# Jarvis Backend Configuration

# Database
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
JARVIS_REDIS_URL=redis://localhost:6379/0

# AI Model — choose one:
# Option A: Direct Anthropic API
JARVIS_ANTHROPIC_API_KEY=your-anthropic-api-key-here
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-20250514
JARVIS_USE_BEDROCK=false
# Option B: AWS Bedrock (set USE_BEDROCK=true, no API key needed — uses IAM role)
# JARVIS_USE_BEDROCK=true
# JARVIS_BEDROCK_REGION=ap-south-1
# JARVIS_ANTHROPIC_MODEL=apac.anthropic.claude-sonnet-4-20250514-v1:0

# Embeddings (Voyage AI)
JARVIS_VOYAGE_API_KEY=your-voyage-api-key-here

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=true

# OpenClaw integration
JARVIS_OPENCLAW_GATEWAY_URL=http://localhost:18789
JARVIS_OPENCLAW_HOOK_TOKEN=your-hook-token-here

# Security
JARVIS_BACKEND_TOKEN=your-backend-token-here

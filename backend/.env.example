# Muldro Backend Configuration

# Database
MULDRO_DATABASE_URL=postgresql+asyncpg://muldro:muldro@localhost:5432/muldro
MULDRO_REDIS_URL=redis://localhost:6379/0

# AI Model — choose one:
# Option A: Direct Anthropic API
MULDRO_ANTHROPIC_API_KEY=your-anthropic-api-key-here
MULDRO_ANTHROPIC_MODEL=claude-sonnet-4-6
MULDRO_USE_BEDROCK=false
# Option B: AWS Bedrock (set USE_BEDROCK=true, no API key needed — uses IAM role)
# MULDRO_USE_BEDROCK=true
# MULDRO_BEDROCK_REGION=us-east-1
# MULDRO_ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# Embeddings (Bedrock Titan)
MULDRO_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Server
MULDRO_HOST=0.0.0.0
MULDRO_PORT=8000
MULDRO_DEBUG=true

# Security
MULDRO_BACKEND_TOKEN=your-backend-token-here

# OAuth encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MULDRO_OAUTH_ENCRYPTION_KEY=your-fernet-key-here

# Google OAuth (from client_secret.json)
MULDRO_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
MULDRO_GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
MULDRO_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Auth
MULDRO_SESSION_SECRET_KEY=change-me-to-a-random-string
MULDRO_MAGIC_LINK_TTL_MINUTES=15
MULDRO_SESSION_TTL_HOURS=720

# Frontend (for OAuth redirects)
MULDRO_FRONTEND_URL=http://localhost:3000

# CORS
MULDRO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# GitHub OAuth (optional)
# MULDRO_GITHUB_OAUTH_CLIENT_ID=
# MULDRO_GITHUB_OAUTH_CLIENT_SECRET=
# MULDRO_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# Atlassian OAuth (Jira + Confluence via Rovo MCP; optional)
# MULDRO_ATLASSIAN_OAUTH_CLIENT_ID=
# MULDRO_ATLASSIAN_OAUTH_CLIENT_SECRET=
# MULDRO_ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/atlassian/callback

# Budget
MULDRO_DAILY_TOKEN_BUDGET_USD=5.0

# Logging
# MULDRO_LOG_JSON=true

# Filesystem MCP server root (defaults to ~/muldro-workspace, created on startup)
# MULDRO_FILESYSTEM_MCP_ROOT=/path/to/workspace

# --- Optional Infrastructure (system works without these) ---

# Elasticsearch (trace persistence — falls back to in-memory)
# MULDRO_ELASTICSEARCH_URL=http://localhost:9200

# Qdrant (vector search — falls back to pgvector)
# MULDRO_QDRANT_URL=http://localhost:6333

# Neo4j (graph traversal — disabled if not set)
# MULDRO_NEO4J_URL=bolt://localhost:7687
# MULDRO_NEO4J_USER=neo4j
# MULDRO_NEO4J_PASSWORD=muldrodev

# S3/MinIO (artifact storage)
# Local dev uses the MinIO service from docker-compose (user/password = muldro/muldrodev).
# Leave the access key/secret empty in production to use the IAM role / default chain.
# MULDRO_S3_BUCKET=muldro-artifacts
# MULDRO_S3_ENDPOINT_URL=http://localhost:9000
# MULDRO_S3_REGION=ap-south-1
# MULDRO_S3_ACCESS_KEY_ID=muldro
# MULDRO_S3_SECRET_ACCESS_KEY=muldrodev

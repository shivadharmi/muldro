        "attendees": ["investor@fund.com", "cfo@company.com"],
        "agenda": ["Q1 financials", "Growth metrics", "Hiring plan"],
        "talking_points": ["Revenue up 40%", "Need bridge round discussion"],
        "risks": ["CFO might push back on hiring pace"]
